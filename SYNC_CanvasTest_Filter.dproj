<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{581D3A1C-0229-45F0-8DF9-407D90A40056}</ProjectGuid>
    <ProjectVersion>20.4</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <ProjectName Condition="'$(ProjectName)'==''">SYNC_CanvasTest_Filter</ProjectName>
    <TargetedPlatforms>2</TargetedPlatforms>
    <AppType>Library</AppType>
    <MainSource>SYNC_CanvasTest_Filter.dpr</MainSource>
    <Base>True</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_DebugInformation>1</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win64)'!=''">
    <Cfg_1_Win64>true</Cfg_1_Win64>
    <CfgParent>Cfg_1</CfgParent>
    <Cfg_1>true</Cfg_1>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
    <DCC_Optimize>true</DCC_Optimize>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_DebugInformation>0</DCC_DebugInformation>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_2)'=='true') or '$(Cfg_2_Win64)'!=''">
    <Cfg_2_Win64>true</Cfg_2_Win64>
    <CfgParent>Cfg_2</CfgParent>
    <Cfg_2>true</Cfg_2>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_UnitSearchPath>Lib\Kits\AviUtl2Canvas\Source\Host;Lib\Kits\AviUtl2Canvas\Source\UI;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DcuOutput>$(MSBuildProjectDirectory)\$(Platform)\$(ProjectName)\$(Config)\DCU</DCC_DcuOutput>
    <GenDll>true</GenDll>
    <DCC_ExeOutput>.\Win64\Plugin\$(Config)</DCC_ExeOutput>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
    <SanitizedProjectName>SYNC_CanvasTest_Filter</SanitizedProjectName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
    <Debugger_HostApplication>D:\aviutl2_v2.1.6a\aviutl2.exe</Debugger_HostApplication>
    <Debugger_WorkingDirectory>D:\aviutl2_v2.1.6a</Debugger_WorkingDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2_Win64)'!=''">
    <Debugger_HostApplication>D:\aviutl2_v2.1.6a\aviutl2.exe</Debugger_HostApplication>
    <Debugger_WorkingDirectory>D:\aviutl2_v2.1.6a</Debugger_WorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\Host\AviUtl2FilterTypes.pas" />
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\Host\PluginFilterTable.pas" />
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\Host\PluginFilterContextManager.pas" />
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\Host\SyncFrameCapture.pas" />
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\Host\SyncCanvasPlugin.pas" />
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\UI\SyncCanvasView.pas" />
    <DCCReference Include="Lib\Kits\AviUtl2Canvas\Source\UI\SyncCanvasEditor.pas" />
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">SYNC_CanvasTest_Filter.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">False</Platform>
        <Platform value="Win64">True</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
  <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')" />
  <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')" />
  <PropertyGroup Condition="'$(Config)'=='Debug' And '$(Platform)'=='Win64'">
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' And '$(Platform)'=='Win64'">
  </PropertyGroup>
  <Target Name="CopyTestPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Win64\Plugin\$(Config)\SYNC_CanvasTest_Filter.dll" DestinationFiles="$(MSBuildProjectDirectory)\Win64\Plugin\$(Config)\SYNC_CanvasTest_Filter.auf2" />
  </Target>
</Project>
